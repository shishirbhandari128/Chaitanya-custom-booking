<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="view_chaitanya_service_attribute_list" model="ir.ui.view">
        <field name="name">chaitanya.service.attribute.list</field>
        <field name="model">chaitanya.service.attribute</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="display_type"/>
                <field name="create_variant"/>
                <field name="ecommerce_filter_visible"/>
                <field name="product_attribute_id"/>
            </list>
        </field>
    </record>

    <record id="view_chaitanya_service_attribute_form" model="ir.ui.view">
        <field name="name">chaitanya.service.attribute.form</field>
        <field name="model">chaitanya.service.attribute</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="display_type"/>
                            <field name="create_variant"/>
                            <field name="ecommerce_filter_visible"/>
                        </group>
                        <group>
                            <field name="product_attribute_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Attribute Values">
                            <field name="value_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="default_extra_price"/>
                                    <field name="product_attribute_value_id" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_chaitanya_service_attribute" model="ir.actions.act_window">
        <field name="name">Service Attributes</field>
        <field name="res_model">chaitanya.service.attribute</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>