<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="chaitanya_product_attribute_list" model="ir.ui.view">
        <field name="name">chaitanya.product.attribute.list</field>
        <field name="model">product.attribute</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="display_type"/>
                <field name="create_variant"/>
                <field name="is_service_attribute"/>
            </list>
        </field>
    </record>

    <record id="chaitanya_product_attribute_form" model="ir.ui.view">
        <field name="name">chaitanya.product.attribute.form</field>
        <field name="model">product.attribute</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="display_type"/>
                            <field name="create_variant"/>
                            <field name="is_service_attribute"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Values">
                            <field name="value_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="default_extra_price"/>
                                    <field name="override_duration"
                                           invisible="not parent.is_service_attribute"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_chaitanya_product_attribute" model="ir.actions.act_window">
        <field name="name">Service Attributes</field>
        <field name="res_model">product.attribute</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_service_attribute', '=', True)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('chaitanya_product_attribute_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('chaitanya_product_attribute_form')}),
        ]"/>
    </record>

</odoo>