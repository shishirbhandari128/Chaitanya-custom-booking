<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <template id="booking_start_page" name="Choose Booking Method">
        <t t-call="website.layout">
            <link rel="stylesheet" href="/chaitanya_booking_flow/static/src/css/booking_start.css"/>
            <div id="wrap" class="ch-booking">
                <section class="container ch-flow-page">

                    <!-- Dynamic eyebrow — NOT editable -->
                    <span class="ch-eyebrow" t-out="is_gift and 'Gift Booking' or 'Booking'"/>

                    <!-- Static heading — editable -->
                    <div class="oe_structure" id="ch_start_heading">
                        <h1>Select booking preference</h1>
                    </div>

                    <!-- Dynamic service info — NOT editable -->
                    <p class="ch-lead">
                        <t t-out="service.name"/> · 
                        <t t-out="service.currency_id.symbol"/>
                        <t t-out="service.price"/>
                    </p>

           
                    <div class="ch-method-grid">

                        <a class="ch-method-card"
                           t-att-href="'/booking/select/%s/therapist?gift=%s' % (service.id, is_gift and 1 or 0)">
                            <div class="oe_structure" id="ch_start_card_therapist">
                                <strong>Book by Therapist</strong>
                                <span>Choose a therapist first, then pick from their available dates and times.</span>
                            </div>
                        </a>

                        <a class="ch-method-card"
                           t-att-href="'/booking/select/%s/availability?gift=%s' % (service.id, is_gift and 1 or 0)">
                            <div class="oe_structure" id="ch_start_card_availability">
                                <strong>Book by Availability</strong>
                                <span>Choose a preferred date first, then see therapists with open slots.</span>
                            </div>
                        </a>
                        
                        

                    </div>

                    <!-- Extra drop zone below the cards for banners, text blocks, etc. -->
                    <div class="oe_structure" id="ch_start_footer_zone"/>

                </section>
            </div>
        </t>
    </template>


   <template id="booking_select_page" name="Select Booking Slot">
        <t t-call="website.layout">
            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&amp;family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&amp;display=swap"/>
            <link rel="stylesheet" href="/chaitanya_booking_flow/static/src/css/booking_select.css"/>

            <div id="wrap" class="ch-booking">
                <section id="ch_hero_bg" class="ch-booking-header" data-name="Hero Header">
                    <div class="ch-hero-image-layer oe_structure" id="ch_booking_hero_image">
                        <section class="s_cover ch-hero-cover"
                                data-snippet="s_cover"
                                data-name="Booking Hero Image"
                                style="background-image: url('/chaitanya_booking_flow/static/src/img/booking-hero.jpg');">
                        </section>
                    </div>

                    <div class="ch-header-overlay"/>

                    <div class="ch-header-content">
                        <div class="container">
                            <div class="oe_structure" id="ch_booking_hero_text">
                                <a t-att-href="'/booking/start/%s?gift=%s' % (service.id, is_gift and 1 or 0)"
                                class="ch-back-link">Booking preference</a>

                                <div>
                                    <span class="ch-eyebrow"
                                        t-out="booking_method == 'therapist' and 'Book by Therapist' or 'Book by Availability'"/>
                                </div>

                                <h1 class="ch-header-title">Choose Your Therapist &amp; Time</h1>
                                <p class="ch-header-service-name" t-out="service.name"/>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="container ch-flow-page">
                    <form action="/booking/submit" method="post" class="ch-booking-form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="service_id" t-att-value="service.id"/>
                        <input type="hidden" name="booking_method" t-att-value="booking_method"/>
                        <input type="hidden" name="is_gift" id="chIsGift" t-att-value="is_gift and 1 or 0"/>
                        <input type="hidden" name="provider_id" id="chProviderId"/>
                        <input type="hidden" name="start_datetime" id="chStartDatetime"/>

                        <div class="ch-booking-shell">
                            <div class="ch-form-panel">

                                <t t-if="booking_method == 'availability'">
                                    <div class="ch-panel-section" id="chDateSection">
                                        <div class="ch-section-header">
                                            <h2 class="ch-section-title">Select Date</h2>
                                        </div>

                                        <div id="chDateInputWrap">
                                            <span class="ch-date-label">Preferred Date</span>
                                            <input type="date" id="chBookingDate" style="max-width:220px;"/>
                                        </div>

                                        <div id="chDateSelectWrap" hidden="hidden">
                                            <span class="ch-date-label">Available Date</span>
                                            <select id="chAvailableDateSelect" style="max-width:220px;">
                                                <option value="">Choose therapist first</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="ch-panel-section" id="chSlotSection">
                                        <div class="ch-section-header">
                                            <div class="oe_structure" id="ch_pick_time_title">
                                                <h2 class="ch-section-title">Pick a Time Slot</h2>
                                            </div>
                                        </div>

                                        <p class="ch-slots-label">Available Times</p>

                                        <div id="chSlotCards" class="ch-slot-card-grid">
                                            <p class="ch-empty-state">Choose a date to see available times.</p>
                                        </div>
                                    </div>

                                    <div class="ch-panel-section" id="chTherapistSection">
                                        <div class="ch-section-header">
                                            <h2 class="ch-section-title">Select a Therapist</h2>
                                        </div>

                                        <div id="chTherapistCards"
                                            class="ch-therapist-card-grid o_not_editable"
                                            contenteditable="false">
                                            <p class="ch-empty-state">Choose a time slot to see therapists.</p>
                                        </div>
                                    </div>
                                </t>

                                <t t-if="booking_method == 'therapist'">
                                    <div class="ch-panel-section" id="chTherapistSection">
                                        <div class="ch-section-header">
                                            <h2 class="ch-section-title">Select a Therapist</h2>
                                        </div>

                                        <div id="chTherapistCards"
                                            class="ch-therapist-card-grid o_not_editable"
                                            contenteditable="false">
                                            <p class="ch-empty-state is-loading">Loading therapists...</p>
                                        </div>
                                    </div>

                                    <div class="ch-panel-section" id="chDateSection">
                                        <div class="ch-section-header">
                                            <div class="oe_structure" id="ch_pick_date_title">
                                                <h2 class="ch-section-title">Select Date</h2>
                                            </div>
                                        </div>

                                        <div id="chDateInputWrap" hidden="hidden">
                                            <span class="ch-date-label">Preferred Date</span>
                                            <input type="date" id="chBookingDate" style="max-width:220px;"/>
                                        </div>

                                        <div id="chDateSelectWrap">
                                            <span class="ch-date-label">Available Date</span>
                                            <select id="chAvailableDateSelect" style="max-width:220px;">
                                                <option value="">Choose therapist first</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="ch-panel-section" id="chSlotSection">
                                        <div class="ch-section-header">
                                            <div class="oe_structure" id="ch_pick_time_title">
                                                <h2 class="ch-section-title">Pick a Time Slot</h2>
                                            </div>
                                        </div>

                                        <p class="ch-slots-label">Available Times Today</p>

                                        <div id="chSlotCards" class="ch-slot-card-grid">
                                            <p class="ch-empty-state">Choose a therapist to see times.</p>
                                        </div>
                                    </div>
                                </t>

                            </div>

                            <div class="ch-sidebar">
                                <div class="ch-order-summary">
                                    <div class="ch-order-summary-head">
                                        <h3>Order Summary</h3>
                                        <p t-out="service.name"/>
                                    </div>

                                    <div class="ch-order-summary-body">
                                        <div class="ch-order-row">
                                            <span>Service</span>
                                            <span t-out="service.name"/>
                                        </div>

                                        <div class="ch-order-row">
                                            <span>Duration</span>
                                            <span><t t-out="service.duration"/> min</span>
                                        </div>

                                        <div class="ch-order-row is-total" id="chPriceBox">
                                            <span>Total Price</span>
                                            <strong class="ch-order-price">
                                                <t t-out="service.currency_id.symbol"/><t t-out="service.price"/>
                                            </strong>
                                        </div>
                                    </div>
                                </div>

                                <div class="ch-gift-card" id="chGiftFields"
                                    t-att-hidden="not is_gift and 'hidden' or None">
                                    <h3 class="ch-gift-card-title">Gift Options</h3>

                                    <div class="ch-gift-field">
                                        <label>Delivery Type</label>
                                        <select name="gift_delivery_type" id="chGiftDeliveryType">
                                            <option value="online">Online (Email)</option>
                                            <option value="local">Local Address</option>
                                        </select>
                                    </div>

                                    <div class="ch-gift-field" id="chGiftEmailWrap">
                                        <label>Recipient's Email</label>
                                        <input type="email"
                                            name="gift_recipient_email"
                                            id="chGiftRecipientEmail"
                                            placeholder="recipient@email.com"/>
                                    </div>

                                    <div class="ch-gift-field" id="chGiftAddressWrap" hidden="hidden">
                                        <label>Recipient Address</label>
                                        <textarea name="gift_recipient_address"
                                                id="chGiftRecipientAddress"
                                                rows="2"
                                                placeholder="Full delivery address"/>
                                    </div>

                                    <div class="ch-gift-field">
                                        <label>Gift Message</label>
                                        <textarea name="gift_message"
                                                rows="3"
                                                placeholder="Write a special message..."/>
                                    </div>
                                </div>

                                <div class="ch-checkout-cta">
                                    <div class="oe_structure" id="ch_select_checkout_note">
                                        <p class="ch-checkout-note">
                                            This reserves your selected slot, adds the service to cart,
                                            and sends you to checkout.
                                        </p>
                                    </div>

                                    <div class="oe_structure" id="ch_select_cta">
                                        <button type="submit" class="ch-submit-btn">
                                            Add to Cart Proceed to Checkout
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </section>
            </div>

            <script src="/chaitanya_booking_flow/static/src/js/booking.js"></script>
        </t>
    </template>

    <template id="booking_error_page" name="Chaitanya Booking Error">
        <t t-call="website.layout">
            <link rel="stylesheet" href="/chaitanya_booking_flow/static/src/css/booking.css"/>
            <div id="wrap" class="ch-booking">
                <section class="container ch-success">

                    <!-- Static heading — editable -->
                    <div class="oe_structure" id="ch_error_heading">
                        <h1>Booking Could Not Be Completed</h1>
                    </div>

                    <!-- Dynamic error message — NOT editable -->
                    <p t-out="message"/>

                    <!-- CTA button — label editable, href is static so fully editable -->
                    <div class="oe_structure" id="ch_error_cta">
                        <a class="btn btn-primary" href="/services">
                            Choose Another Slot
                        </a>
                    </div>

                    <!-- Extra drop zone — for support contact info, FAQs, etc. -->
                    <div class="oe_structure" id="ch_error_footer_zone"/>

                </section>
            </div>
        </t>
    </template>

</odoo>