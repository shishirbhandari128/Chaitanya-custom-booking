    <template id="booking_start_page" name="Choose Booking Method">
        <t t-call="website.layout">
            <link rel="stylesheet" href="/chaitanya_booking_flow/static/src/css/booking.css"/>
            <div id="wrap" class="ch-booking">
                <section class="container ch-flow-page">
                    <!-- <a t-att-href="'/services/%s' % service.id" class="ch-back-link">Back to service</a> -->
                    <span class="ch-eyebrow" t-out="is_gift and 'Gift Booking' or 'Booking'"/>
                    <h1>Select booking preference</h1>
                    <p class="ch-lead"><t t-out="service.name"/> · <t t-out="service.currency_id.symbol"/> <t t-out="service.price"/></p>
                    <div class="ch-method-grid">
                        <a class="ch-method-card" t-att-href="'/booking/select/%s/therapist?gift=%s' % (service.id, is_gift and 1 or 0)">
                            <strong>Book by Therapist</strong>
                            <span>Choose a therapist first, then pick from their available dates and times.</span>
                        </a>
                        <a class="ch-method-card" t-att-href="'/booking/select/%s/availability?gift=%s' % (service.id, is_gift and 1 or 0)">
                            <strong>Book by Availability</strong>
                            <span>Choose a preferred date first, then see therapists with open slots.</span>
                        </a>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="booking_select_page" name="Select Booking Slot">
        <t t-call="website.layout">
            <link rel="stylesheet" href="/chaitanya_booking_flow/static/src/css/booking.css"/>

            <div id="wrap" class="ch-booking">
                <section class="container ch-flow-page">
                    <a t-att-href="'/booking/start/%s?gift=%s' % (service.id, is_gift and 1 or 0)"
                    class="ch-back-link">
                        Booking preference
                    </a>

                    <span class="ch-eyebrow"
                        t-out="booking_method == 'therapist' and 'Book by Therapist' or 'Book by Availability'"/>

                    <h1>Select therapist and time</h1>
                    <p class="ch-lead" t-out="service.name"/>

                    <form action="/booking/submit" method="post" class="ch-booking-form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="service_id" t-att-value="service.id"/>
                        <input type="hidden" name="booking_method" t-att-value="booking_method"/>
                        <input type="hidden" name="is_gift" id="chIsGift" t-att-value="is_gift and 1 or 0"/>

                        <input type="hidden" name="provider_id" id="chProviderId"/>
                        <input type="hidden" name="start_datetime" id="chStartDatetime"/>

                        <div class="ch-form-grid">
                            <label id="chDateInputWrap"
                                t-att-hidden="booking_method == 'therapist' and 'hidden' or None">
                                Preferred Date
                                <input type="date" id="chBookingDate"/>
                            </label>

                            <label id="chDateSelectWrap"
                                t-att-hidden="booking_method == 'availability' and 'hidden' or None">
                                Available Date
                                <select id="chAvailableDateSelect">
                                    <option value="">Choose therapist first</option>
                                </select>
                            </label>

                            <label>
                                Voucher Code
                                <input type="text" name="voucher_code" id="chVoucherCode" placeholder="Optional"/>
                            </label>
                        </div>

                        <div class="ch-card-section">
                            <h2>Available Therapists</h2>
                            <div id="chTherapistCards" class="ch-therapist-card-grid">
                                <p class="ch-empty-state">Loading therapists...</p>
                            </div>
                        </div>

                        <div class="ch-card-section">
                            <h2>Available Times</h2>
                            <div id="chSlotCards" class="ch-slot-card-grid">
                                <p class="ch-empty-state">Choose a therapist to see times.</p>
                            </div>
                        </div>

                        <div class="ch-price-box" id="chPriceBox">
                            <span>Price</span>
                            <strong>
                                <t t-out="service.currency_id.symbol"/>
                                <t t-out="service.price"/>
                            </strong>
                        </div>

                        <fieldset class="ch-gift-fields" id="chGiftFields"
                                t-att-hidden="not is_gift and 'hidden' or None">
                            <legend>Gift Details</legend>

                            <label>
                                Delivery Type
                                <select name="gift_delivery_type" id="chGiftDeliveryType">
                                    <option value="online">Online</option>
                                    <option value="local">Local Address</option>
                                </select>
                            </label>

                            <label id="chGiftEmailWrap">
                                Recipient Email
                                <input type="email" name="gift_recipient_email" id="chGiftRecipientEmail"/>
                            </label>

                            <label id="chGiftAddressWrap" hidden="hidden">
                                Recipient Address
                                <textarea name="gift_recipient_address" id="chGiftRecipientAddress" rows="2"/>
                            </label>

                            <label>
                                Gift Message
                                <textarea name="gift_message" rows="2"/>
                            </label>
                        </fieldset>

                        <p class="ch-checkout-note">
                            This reserves your selected slot, adds the service to cart, and sends you to Odoo checkout.
                        </p>

                        <button type="submit" class="btn btn-primary">
                            Add to Cart and Checkout
                        </button>
                    </form>
                </section>
            </div>

            <script src="/chaitanya_booking_flow/static/src/js/booking.js"></script>
        </t>
    </template>

    <template id="booking_success_page" name="Chaitanya Booking Success">
        <t t-call="website.layout">
            <link rel="stylesheet" href="/chaitanya_booking_flow/static/src/css/booking.css"/>
            <div id="wrap" class="ch-booking">
                <section class="container ch-success">
                    <h1>Booking Confirmed</h1>
                    <p>Your booking reference is <strong t-out="booking.name"/>.</p>
                    <dl class="ch-summary">
                        <dt>Service</dt><dd t-out="booking.service_id.name"/>
                        <dt>Therapist</dt><dd t-out="booking.provider_id.name"/>
                        <dt>Date and Time</dt><dd t-out="booking.start_datetime"/>
                        <dt>Customer</dt><dd t-out="booking.customer_name"/>
                        <dt>Payment</dt><dd><t t-out="booking.payment_method"/> / <t t-out="booking.payment_status"/></dd>
                        <dt>Total</dt><dd><t t-out="booking.currency_id.symbol"/> <t t-out="booking.final_amount"/></dd>
                    </dl>
                    <a class="btn btn-primary" t-att-href="'/booking/download/%s' % booking.name">Download PDF Summary</a>
                    <a class="btn btn-outline-primary" href="/services">Book Another Service</a>
                </section>
            </div>
        </t>
    </template>

    <template id="booking_error_page" name="Chaitanya Booking Error">
        <t t-call="website.layout">
            <link rel="stylesheet" href="/chaitanya_booking_flow/static/src/css/booking.css"/>
            <div id="wrap" class="ch-booking">
                <section class="container ch-success">
                    <h1>Booking Could Not Be Completed</h1>
                    <p t-out="message"/>
                    <a class="btn btn-primary" href="/services">Choose Another Slot</a>
                </section>
            </div>
        </t>
    </template>
</odoo>
