<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chaitanya_voucher_list" model="ir.ui.view">
        <field name="name">chaitanya.appointment.voucher.list</field>
        <field name="model">chaitanya.appointment.voucher</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="voucher_type"/>
                <field name="discount_type"/>
                <field name="discount_value"/>
                <field name="expiry_date"/>
                <field name="usage_limit"/>
                <field name="usage_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_chaitanya_voucher_form" model="ir.ui.view">
        <field name="name">chaitanya.appointment.voucher.form</field>
        <field name="model">chaitanya.appointment.voucher</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="voucher_type"/>
                            <field name="state"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="discount_type"/>
                            <field name="discount_value"/>
                            <field name="expiry_date"/>
                            <field name="usage_limit"/>
                            <field name="usage_count"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_chaitanya_voucher" model="ir.actions.act_window">
        <field name="name">Vouchers</field>
        <field name="res_model">chaitanya.appointment.voucher</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

