<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chaitanya_booking_calendar_event_list" model="ir.ui.view">
        <field name="name">chaitanya.calendar.event.booking.list</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'reserved'"
                  decoration-danger="state == 'cancelled'"
                  decoration-muted="active == False">
                <field name="name"/>
                <field name="partner_ids" widget="many2many_tags"/>
                <field name="appointment_type_id"/>
                <field name="product_variant_description"/>
                <field name="provider_id"/>
                <field name="start"/>
                <field name="stop"/>
                <field name="sale_order_id"/>
                <field name="base_amount"/>
                <field name="discount_amount"/>
                <field name="final_amount"/>
                <field name="payment_method"/>
                <field name="payment_status"/>
                <field name="state"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_chaitanya_booking_calendar_event_form" model="ir.ui.view">
        <field name="name">chaitanya.calendar.event.booking.form</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="reserved,cancelled"/>

                    <button name="action_view_sale_order"
                            string="View Sale Order"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'cancelled' or not sale_order_id"/>

                    <button name="action_confirm_sale_order"
                            string="Confirm Entire Order"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'cancelled' or not sale_order_id or sale_order_state not in ('draft', 'sent')"/>

                    <button name="action_create_invoice"
                            string="Create Invoice"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'cancelled' or not sale_order_id or invoice_count != 0"/>

                    <button name="action_view_invoices"
                            string="View Invoices"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'cancelled' or invoice_count == 0"/>

                    <button name="action_view_related_order_bookings"
                            string="Related Bookings"
                            type="object"
                            class="btn-secondary"
                            invisible="not sale_order_id"/>

                    <button name="action_cancel"
                            string="Cancel This Booking"
                            type="object"
                            invisible="state == 'cancelled' or not sale_order_id or sale_order_state not in ('draft', 'sent')"/>

                    <button name="action_cancel_entire_order"
                            string="Cancel Entire Order"
                            type="object"
                            class="btn-secondary"
                            invisible="not sale_order_id or sale_order_state == 'cancel'"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Appointment">
                            <field name="appointment_type_id"/>
                            <field name="product_template_id"/>
                            <field name="product_id"/>
                            <field name="product_variant_description"/>
                            <field name="provider_id"/>
                            <field name="booking_method"/>
                            <field name="start"/>
                            <field name="stop"/>
                            <field name="duration"/>
                            <field name="active"/>
                        </group>

                        <group string="Customer">
                            <field name="partner_ids" widget="many2many_tags"/>
                            <field name="customer_name"/>
                            <field name="customer_email"/>
                            <field name="customer_phone"/>
                        </group>
                    </group>

                    <group>
                        <group string="Payment">
                            <field name="currency_id"/>
                            <field name="base_amount"/>
                            <field name="discount_amount"/>
                            <field name="final_amount"/>
                            <field name="active_amount"/>
                            <field name="refunded_amount"/>
                            <field name="net_amount"/>
                            <field name="sale_order_state"/>
                            <field name="sale_order_amount_total"/>
                            <field name="invoice_status"/>
                            <field name="invoice_count"/>
                            <field name="invoice_amount_total"/>
                            <field name="invoice_amount_residual"/>
                            <field name="payment_method"/>
                            <field name="payment_status"/>
                            <field name="voucher_id"/>
                            <field name="sale_order_id"/>
                            <field name="sale_order_line_id"/>
                        </group>

                        <group string="Gift">
                            <field name="is_gift"/>
                            <field name="gift_delivery_type"/>
                            <field name="gift_recipient_email"/>
                            <field name="gift_recipient_address"/>
                            <field name="gift_message"/>
                        </group>

                        <group string="Order">
                            <field name="sale_order_state"/>
                            <field name="related_order_booking_count"/>
                            <field name="related_order_cancelled_booking_count"/>
                            <field name="order_has_non_booking_lines"/>
                        </group>
                    </group>

                    <field name="description"/>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_chaitanya_booking" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('appointment_type_id', '!=', False)]</field>
        <field name="context">{'active_test': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_chaitanya_booking_calendar_event_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_chaitanya_booking_calendar_event_form')}),
        ]"/>
    </record>
</odoo>