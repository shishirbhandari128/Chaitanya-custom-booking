<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chaitanya_booking_list" model="ir.ui.view">
        <field name="name">chaitanya.appointment.booking.list</field>
        <field name="model">chaitanya.appointment.booking</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'reserved'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="customer_name"/>
                <field name="service_id"/>
                <field name="provider_id"/>
                <field name="start_datetime"/>
                <field name="sale_order_id"/>
                <field name="final_amount"/>
                <field name="payment_method"/>
                <field name="payment_status"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    

    <record id="view_chaitanya_booking_form" model="ir.ui.view">
        <field name="name">chaitanya.appointment.booking.form</field>
        <field name="model">chaitanya.appointment.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state == 'cancelled'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="reserved,cancelled"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Appointment">
                            <field name="service_id"/>
                            <field name="provider_id"/>
                            <field name="booking_method"/>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="duration"/>
                        </group>

                        <group string="Customer">
                            <field name="partner_id"/>
                            <field name="customer_name"/>
                            <field name="customer_email"/>
                            <field name="customer_phone"/>
                        </group>
                    </group>

                    <group>
                        <group string="Payment">
                            <field name="currency_id"/>
                            <field name="base_amount"/>
                            <field name="discount_amount"/>
                            <field name="final_amount"/>
                            <field name="payment_method"/>
                            <field name="payment_status"/>
                            <field name="voucher_id"/>
                            <field name="sale_order_id"/>
                            <field name="sale_order_line_id"/>
                        </group>

                        <group string="Gift">
                            <field name="is_gift"/>
                            <field name="gift_delivery_type"/>
                            <field name="gift_recipient_email"/>
                            <field name="gift_recipient_address"/>
                            <field name="gift_message"/>
                        </group>
                    </group>

                    <field name="notes"/>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_chaitanya_booking" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">chaitanya.appointment.booking</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>


