<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- SCHEDULE TEMPLATE -->
    <!-- ===================================================== -->

    <record id="view_schedule_template_tree" model="ir.ui.view">
        <field name="name">schedule.template.tree</field>
        <field name="model">chaitanya.appointment.schedule.template</field>

        <field name="arch" type="xml">
            <list>
                <field name="provider_id"/>
                <field name="active"/>      
            </list>
        </field>
    </record>


    <record id="view_schedule_template_form" model="ir.ui.view">
        <field name="name">schedule.template.form</field>

        <field name="model">chaitanya.appointment.schedule.template</field>

        <field name="arch" type="xml">

            <form>
                <sheet>

                    <group>
                        <field name="provider_id"/>
                        <field name="active"/>
                    </group>

                    <notebook>

                        <page string="Schedule Dates">

                            <field name="date_ids">
                                <list>
                                    <field name="date"/>
                                    <field name = "slot_ids"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="date"/>
                                        </group>
                                        <field name="slot_ids">
                                            <list editable="bottom">
                                                <field name="is_off"/>

                                                <field name="start_hour"/>
                                                <field name="end_hour"/>
                                                <field name="slot_interval"/>
                                            </list>
                                        </field>
                                    </sheet>
                                </form>
                            </field>


                        </page>

                    </notebook>

                </sheet>
            </form>

        </field>
    </record>


    <record id="action_schedule_template" model="ir.actions.act_window">
        <field name="name">Schedules</field>

        <field name="res_model">chaitanya.appointment.schedule.template</field>

        <field name="view_mode">list,form</field>
    </record>


