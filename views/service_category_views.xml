<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chaitanya_service_category_list" model="ir.ui.view">
        <field name="name">chaitanya.appointment.service.category.list</field>
        <field name="model">chaitanya.appointment.service.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="website_published"/>
                <field name="active"/>
                <field name="ecommerce_category_id"/>
            </list>
        </field>
    </record>

    <record id="view_chaitanya_service_category_form" model="ir.ui.view">
        <field name="name">chaitanya.appointment.service.category.form</field>
        <field name="model">chaitanya.appointment.service.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="website_published"/>
                            <field name="active"/>
                            <field name="ecommerce_category_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="image" widget="image"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_chaitanya_service_category" model="ir.actions.act_window">
        <field name="name">Service Categories</field>
        <field name="res_model">chaitanya.appointment.service.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
