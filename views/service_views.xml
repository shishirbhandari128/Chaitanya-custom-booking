<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chaitanya_service_list" model="ir.ui.view">
        <field name="name">chaitanya.appointment.service.list</field>
        <field name="model">chaitanya.appointment.service</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="duration"/>
                <field name="price"/>
                <field name="website_published"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_chaitanya_service_form" model="ir.ui.view">
        <field name="name">chaitanya.appointment.service.form</field>
        <field name="model">chaitanya.appointment.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="category_id"/>
                            <field name="short_description"/>
                            <field name="duration"/>
                            <field name="price"/>
                            <field name="product_id"/>
                            <field name="currency_id"/>
                            <field name="allow_gift"/>
                            <field name="website_published"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="image" widget="image"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Therapists">
                            <field name="provider_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Benefits">
                            <field name="benefits"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_chaitanya_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">chaitanya.appointment.service</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
