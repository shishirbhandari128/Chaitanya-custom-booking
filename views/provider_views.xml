<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chaitanya_provider_list" model="ir.ui.view">
        <field name="name">chaitanya.appointment.provider.list</field>
        <field name="model">chaitanya.appointment.provider</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id" optional="hide"/>
                <field name="specialization"/>
                <field name="specialty_ids" widget="many2many_tags"/>
                <field name="is_active_for_booking"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_chaitanya_provider_form" model="ir.ui.view">
        <field name="name">chaitanya.appointment.provider.form</field>
        <field name="model">chaitanya.appointment.provider</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="user_id"/>
                            <field name="specialization"/>
                            <field name="specialty_ids" widget="many2many_tags"/>
                            <field name="is_active_for_booking"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="image" widget="image"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Services">
                            <field name="service_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Availability">
                            <field name="available_slot_ids"/>
                        </page>
                        <page string="Bio">
                            <field name="bio"/>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_chaitanya_provider" model="ir.actions.act_window">
        <field name="name">Therapists</field>
        <field name="res_model">chaitanya.appointment.provider</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

